# Django environment settings
SECRET_KEY=change-in-production-use-a-strong-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.docusense.ai,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.docusense.ai,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://app.docusense.ai,https://api.docusense.ai

# Database - SQLite 3 Engine
# Optional custom path to SQLite database file (defaults to BASE_DIR / 'db.sqlite3')
# In persistent container/VM setups, set this to a mounted volume path (e.g. /data/db.sqlite3)
SQLITE_DB_PATH=

# Media Storage - Uploaded Contract Files
# Optional custom path to uploaded media storage directory (defaults to BASE_DIR / 'media')
# In persistent container/VM setups, set this to a mounted volume path (e.g. /data/media)
MEDIA_DIR=


# Production Security & SSL (True in production behind HTTPS load balancer / proxy)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# AI Provider Configuration (OpenAI / Anthropic / Gemini Compatible)
# Leave blank to use deterministic legal NLP reasoning engine
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1/chat/completions

